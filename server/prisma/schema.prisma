generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  name             String
  passwordHash     String?
  googleId         String?        @unique
  avatar           String?
  role             String         @default("member")
  status           String         @default("active")
  inviteToken      String?        @unique
  inviteExpires    DateTime?
  signature        String?
  signatureImage   String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  activities       Activity[]
  companies        Company[]
  deals            Deal[]
  emailAccounts    EmailAccount[]
  sentMessages     ChatMessage[]  @relation("SentMessages")
  receivedMessages ChatMessage[]  @relation("ReceivedMessages")
}

model Company {
  id             String     @id @default(cuid())
  name           String
  email          String?
  phone          String?
  industry       String?
  leadStatus     String?
  status         String     @default("Lead")
  notes          String?
  ownerId        String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  domain                String?
  country               String?
  emails                Json?
  phones                Json?
  endPdpUrl             String?
  cms                   String?
  remarks               String?
  contactPersons        Json?
  linkedProfiles        Json?
  deletedAt             DateTime?
  activities     Activity[]
  deals          Deal[]
  callLogs       CallLog[]
  owner          User?      @relation(fields: [ownerId], references: [id])

  @@index([email])
  @@index([deletedAt])
  @@index([ownerId])
  @@index([createdAt])
  @@index([leadStatus])
  @@index([name])
}

model Deal {
  id        String    @id @default(cuid())
  title     String
  value     Float     @default(0)
  stage     String    @default("Discussion")
  companyId String?
  ownerId   String
  closeDate DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  country             String?
  companyName         String?
  domainName          String?
  clientType          String?
  contactPerson       String?
  contactPhone        String?
  contactEmail        String?
  serviceRequirement  String?
  clientWebsiteUrl    String?
  opportunityType     String?
  strategicImportance String?
  expectedOutcome     String?
  company   Company?  @relation(fields: [companyId], references: [id])
  owner     User      @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([companyId])
}

model Activity {
  id            String    @id @default(cuid())
  type          String
  userId        String
  title         String?
  body          String?
  toEmail       String?
  fromEmail     String?
  subject       String?
  emailStatus   String?
  direction     String?
  duration      Int?
  outcome       String?
  startTime     DateTime?
  endTime       DateTime?
  meetingStatus String?
  location      String?
  participants  String?
  dueDate       DateTime?
  priority      String?
  taskStatus    String?
  assignedToId  String?
  meetLink      String?
  messageId     String?
  threadId      String?
  companyId     String?
  trackingId    String?   @unique
  openCount     Int       @default(0)
  firstOpenedAt DateTime?
  lastOpenedAt  DateTime?
  openHistory   Json?
  recordingUrl  String?
  callLogId     String?   @unique
  // Which of the company's saved email addresses this conversation belongs to.
  // Drives the Company → Email Address → Thread → Messages grouping; null for
  // non-email activities and for emails whose matched address was later removed.
  matchedCompanyEmail String?
  ccEmail       String?
  attachments   Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([messageId])
  @@index([type])
  @@index([userId])
  @@index([threadId])
  @@index([matchedCompanyEmail])
}

model CallLog {
  id              String    @id @default(cuid())
  callhippoId     String    @unique
  callDate        DateTime
  fromNumber      String?
  toNumber        String?
  direction       String?
  status          String?
  duration        Int?
  recordingUrl    String?
  agentName       String?
  agentId         String?
  analysisStatus  String?
  analysisResult  Json?
  analysisError   String?
  companyId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company?  @relation(fields: [companyId], references: [id])

  @@index([callDate])
  @@index([analysisStatus])
  @@index([companyId])
}

model ChatMessage {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  body       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  fromUser   User     @relation("SentMessages",     fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("ReceivedMessages", fields: [toUserId],   references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@index([toUserId])
  @@index([createdAt])
}

model EmailAccount {
  id           String    @id @default(cuid())
  userId       String
  provider     String
  email        String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}
